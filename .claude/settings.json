{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(uv add *)",
      "Bash(uv lock *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh search *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)"
    ],
    "deny": [
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(git push --force *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(git push --force *)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
